# Generate locally with npm exec tsx scripts/admin-key.ts. Never commit secrets.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional display identifier for audit events (not a password)
ADMIN_USERNAME=operator
# Durable Vercel backend: fine-grained token restricted to visable-guide Contents read/write.
# No permission to VISABLE is needed. Configure secrets only in Vercel dashboard.
CONTENT_GITHUB_TOKEN=
CONTENT_GITHUB_REPO=club-paradiso/visable-guide
CONTENT_GITHUB_BRANCH=content
CONTENT_GITHUB_PATH=data/published.json
# Local development only (Vercel explicitly refuses filesystem writes).
CONTENT_LOCAL_DIR=runtime
